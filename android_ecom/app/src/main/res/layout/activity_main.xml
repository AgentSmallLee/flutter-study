<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.MainActivity">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="红松心选 - Android 原生"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flutter Module 嵌入原生 App 的混合开发演示"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnOpenEcom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="打开 Flutter 电商模块"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toBottomOf="@id/tvDesc"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnOpenEcomWithParams"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="带参数打开 Flutter 商品详情"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnOpenEcom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvArchitecture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="架构说明：\n• 多仓模式：Android / iOS / Flutter 各独立仓库\n• Flutter 以 Module 形式嵌入，产物为 aar\n• 原生通过 MethodChannel 为 Flutter 提供能力\n• 混合栈路由由原生管理"
        android:textSize="12sp"
        android:textColor="@android:color/darker_gray"
        android:lineSpacingExtra="4dp"
        android:background="@android:color/black"
        android:padding="12dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/btnOpenEcomWithParams"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
